---
import { getRelativeLocaleUrl } from "astro:i18n";
import SplitBand from "../components/SplitBand.astro";
import { getCopy } from "../data/copy";
import { getLocale } from "../data/locale";
import { getServices } from "../data/site";
import SiteLayout from "../layouts/SiteLayout.astro";

const locale = getLocale(Astro.currentLocale);
const copy = getCopy(locale);
const services = getServices(locale);
const audio = services[0];
const visuals = services[1];
const sfeer = services[2];
const bookHref = getRelativeLocaleUrl(locale, "contact");
---

<SiteLayout description={copy.diensten.description} title={copy.diensten.title}>
  <main id="main">
    <header class="pageIntro">
      <p class="kicker">{copy.diensten.kicker}</p>
      <h1 class="pageTitle">{copy.diensten.heading}</h1>
      <p class="heroCopy">{copy.diensten.intro}</p>
    </header>

    <SplitBand
      alt={audio.photo.alt}
      caption={audio.photo.caption}
      src={audio.photo.src}
    >
      <h2 class="sectionTitle">{audio.title}</h2>
      <p class="heroCopy">{audio.body}</p>
    </SplitBand>

    <SplitBand
      alt={visuals.photo.alt}
      caption={visuals.photo.caption}
      flip
      src={visuals.photo.src}
    >
      <h2 class="sectionTitle">{visuals.title}</h2>
      <p class="heroCopy">{visuals.body}</p>
    </SplitBand>

    <SplitBand
      alt={sfeer.photo.alt}
      caption={sfeer.photo.caption}
      src={sfeer.photo.src}
    >
      <h2 class="sectionTitle">{sfeer.title}</h2>
      <p class="heroCopy">{sfeer.body}</p>
      <div class="actions">
        <a class="button buttonPrimary" href={bookHref}>{copy.book}</a>
      </div>
    </SplitBand>
  </main>
</SiteLayout>
