---
import { ContactForm } from "../components/ContactForm";
import SplitBand from "../components/SplitBand.astro";
import { getCopy } from "../data/copy";
import { getLocale } from "../data/locale";
import { getPhotos, site } from "../data/site";
import SiteLayout from "../layouts/SiteLayout.astro";

const locale = getLocale(Astro.currentLocale);
const copy = getCopy(locale);
const photos = getPhotos(locale);
---

<SiteLayout description={copy.contact.description} title={copy.contact.title}>
  <main id="main">
    <SplitBand
      alt={photos.podium.alt}
      caption={photos.podium.caption}
      flip
      src={photos.podium.src}
      variant="hero"
    >
      <p class="kicker">{copy.contact.kicker}</p>
      <h1 class="pageTitle">{copy.contact.heading}</h1>
      <p class="heroCopy">{copy.contact.intro}</p>
      <p class="heroCopy">
        {copy.contact.mailDirect}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <ContactForm client:load copy={copy.form} email={site.email} />
    </SplitBand>
  </main>
</SiteLayout>
