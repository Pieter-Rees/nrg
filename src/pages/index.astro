---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Equalizer } from "../components/Equalizer";
import EventPhoto from "../components/EventPhoto.astro";
import SplitBand from "../components/SplitBand.astro";
import { fillTemplate, getCopy } from "../data/copy";
import { getLocale } from "../data/locale";
import { getPhotos, getServices, site } from "../data/site";
import SiteLayout from "../layouts/SiteLayout.astro";

const locale = getLocale(Astro.currentLocale);
const copy = getCopy(locale);
const photos = getPhotos(locale);
const services = getServices(locale);
const audio = services[0];
const visuals = services[1];
const sfeer = services[2];
const bookHref = getRelativeLocaleUrl(locale, "contact");
const workHref = getRelativeLocaleUrl(locale, "werk");
const servicesHref = getRelativeLocaleUrl(locale, "diensten");
const homeIntro = fillTemplate(copy.home.intro, { location: site.location });
---

<SiteLayout description={homeIntro}>
  <main id="main">
    <SplitBand
      alt={photos.publiek.alt}
      caption={photos.publiek.caption}
      src={photos.publiek.src}
      variant="hero"
    >
      <p class="kicker">{copy.home.kicker}</p>
      <div class="heroBrand">
        <h1>{site.shortName}</h1>
        <Equalizer client:visible />
      </div>
      <p class="tagline">{copy.tagline}</p>
      <div class="heroCopy">
        <p>{homeIntro}</p>
      </div>
      <div class="actions">
        <a class="button buttonPrimary" href={bookHref}>{copy.book}</a>
        <a class="button buttonGhost" href={workHref}>{copy.seeWork}</a>
      </div>
    </SplitBand>

    <SplitBand
      alt={photos.dansvloer.alt}
      caption={photos.dansvloer.caption}
      flip
      src={photos.dansvloer.src}
    >
      <h2 class="sectionTitle">{copy.home.heading}</h2>
      <p class="heroCopy">{copy.home.spaceBody}</p>
    </SplitBand>

    <div class="photoGrid photoGridBleed">
      <EventPhoto
        alt={photos.strand.alt}
        caption={photos.strand.caption}
        src={photos.strand.src}
      />
      <EventPhoto
        alt={photos.licht.alt}
        caption={photos.licht.caption}
        src={photos.licht.src}
      />
    </div>

    <section class="wrap bandPad">
      <h2 class="sectionTitle">{copy.home.whatWeBring}</h2>
      <div class="cards">
        <article class="card">
          <h3>{audio.title}</h3>
          <p>{audio.body}</p>
        </article>
        <article class="card">
          <h3>{visuals.title}</h3>
          <p>{visuals.body}</p>
        </article>
        <article class="card">
          <h3>{sfeer.title}</h3>
          <p>{sfeer.body}</p>
        </article>
      </div>
      <div class="actions">
        <a class="button buttonGhost" href={servicesHref}>{copy.allServices}</a>
      </div>
    </section>

    <SplitBand
      alt={photos.podium.alt}
      caption={photos.podium.caption}
      src={photos.podium.src}
    >
      <h2 class="sectionTitle">{copy.home.readyTitle}</h2>
      <p class="heroCopy">{copy.home.readyBody}</p>
      <div class="actions">
        <a class="button buttonPrimary" href={bookHref}>{copy.book}</a>
      </div>
    </SplitBand>
  </main>
</SiteLayout>
