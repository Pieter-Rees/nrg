---
import SplitBand from "../components/SplitBand.astro";
import { fillTemplate, getCopy } from "../data/copy";
import { getLocale } from "../data/locale";
import { getPhotos, site } from "../data/site";
import SiteLayout from "../layouts/SiteLayout.astro";

const locale = getLocale(Astro.currentLocale);
const copy = getCopy(locale);
const photos = getPhotos(locale);
const aboutBody = fillTemplate(copy.over.body, {
  location: site.location,
  name: site.name,
});
---

<SiteLayout description={copy.over.description} title={copy.over.title}>
  <main id="main">
    <SplitBand
      alt={photos.djBooth.alt}
      caption={photos.djBooth.caption}
      src={photos.djBooth.src}
      variant="hero"
    >
      <p class="kicker">{copy.over.kicker}</p>
      <h1 class="pageTitle">{site.name}</h1>
      <div class="about">
        <p>{aboutBody}</p>
        <p>{copy.tagline}.</p>
      </div>
      <dl class="metaList">
        <div>
          <dt>{copy.over.contact}</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div>
          <dt>{copy.over.basedIn}</dt>
          <dd>{site.location}</dd>
        </div>
        <div>
          <dt>{copy.over.social}</dt>
          <dd><a href={site.facebookUrl}>Facebook</a></dd>
        </div>
      </dl>
    </SplitBand>
  </main>
</SiteLayout>
